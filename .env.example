ENVIRONMENT=development
DEBUG=True

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih_db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256

# Powers Mitra's chat replies (POST /api/v1/mitra/chat). Optional - without
# it Mitra just returns a "not configured" error instead of a reply, nothing
# else breaks. Only whoever runs the backend needs this; the frontend never
# sees the key.
GEMINI_API_KEY=
