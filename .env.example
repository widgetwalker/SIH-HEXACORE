ENVIRONMENT=development
DEBUG=True

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih_db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256

# Powers Mitra's chat replies (POST /api/v1/mitra/chat). Optional - without
# it Mitra just returns a "not configured" error instead of a reply, nothing
# else breaks. Only whoever runs the backend needs this; the frontend never
# sees the key.
GEMINI_API_KEY=

# NDMA SACHET webhook HMAC secret for signature verification.
# Leave empty in dev to skip verification on loopback-only calls.
SACHET_WEBHOOK_SECRET=

# NDMA SACHET CAP v1.2 XML feed URL for the background poller.
# Production URL supplied at deploy time; empty = poller disabled (dev/CI).
SACHET_FEED_URL=

# ── Frontend (copy these to frontend/.env.local) ─────────────────────────
# Next.js requires NEXT_PUBLIC_ prefix for browser-accessible vars.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_WS_TOKEN=your-jwt-token-here
NEXT_PUBLIC_CAMPUS_ID=campus-123
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
